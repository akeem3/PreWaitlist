# Copy to .env.local for local development. Never commit real values.
# Derived from process.env usage in src/ — only vars the app actually reads.

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Canonical site URL (no trailing slash). Used for og:image/metadata base and
# absolute footer links. Unset locally to fall back to https://www.prewaitlist.com.
NEXT_PUBLIC_BASE_URL=https://www.prewaitlist.com

# Resend — https://resend.com/api-keys (key needs Domains scope for the
# sending-domain wizard; webhook secret from Domain → Webhooks)
RESEND_API_KEY=re_xxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# HMAC secret for unsubscribe links in emails. Any long random string.
# Must match the deployed value or existing unsubscribe links break.
UNSUBSCRIBE_SECRET=

# Bearer token guarding /api/cron/* endpoints (Vercel Cron sends it).
# Must match the deployed CRON_SECRET.
CRON_SECRET=

# Paddle — sandbox: https://sandbox-vendors.paddle.com · live: vendors.paddle.com
# Client token + ENV are read by the browser SDK; API key/webhook/price are server-side.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxx
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxx
PADDLE_PRO_PRICE_ID=pri_xxxxxxxx

# PostHog — https://app.posthog.com/settings/project (Project API key)
# Unset locally: the SDK is a no-op without the key (local dev must not error).
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
